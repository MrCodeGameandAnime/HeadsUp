<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GitCiHud.Models"
        xmlns:vm="clr-namespace:GitCiHud.ViewModels"
        x:Class="GitCiHud.Views.MainHudWindow"
        x:DataType="vm:MainHudViewModel"
        Title="HeadsUp"
        Width="560"
        Height="650"
        MinWidth="470"
        MinHeight="520"
        Background="#10151D"
        ShowInTaskbar="True">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value=".7"/>
    </Style>
    <Style Selector="TextBlock.sha">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
    </Style>
    <Style Selector="TextBlock.id">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.detailLabel">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value=".7"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.hud">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Background" Value="#26000000"/>
      <Setter Property="BorderBrush" Value="#48FFFFFF"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.copy">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#48FFFFFF"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.gear">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Styles>

  <Border Margin="1"
          Background="{Binding SurfaceBrush}"
          BorderBrush="#50FFFFFF"
          BorderThickness="1"
          CornerRadius="12"
          Padding="18,14">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Text="{Binding RepositoryName}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding Branch}"
                   Opacity=".82"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   MaxWidth="180"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>

      <Border Grid.Row="1" Background="#26000000" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="GITHUB ACTIONS"/>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1,0,2">
            <TextBlock Text="{Binding CiStatusText}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding RunIdentity}" FontSize="16" FontWeight="SemiBold" Margin="12,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding ConclusionText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
          </Grid>
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="label" Text="SHA" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="sha" Text="{Binding CiSha}" VerticalAlignment="Center" Margin="16,0"/>
            <Button Grid.Column="2" Classes="copy" Content="⧉" IsEnabled="{Binding CanCopySha}" Click="OnCopyShaClick" ToolTip.Tip="Copy full SHA"/>
            <TextBlock Grid.Row="1" Classes="label" Text="RUN ID" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="id" Text="{Binding RunIdText}" VerticalAlignment="Center" Margin="16,0"/>
            <Button Grid.Row="1" Grid.Column="2" Classes="copy" Content="⧉" IsEnabled="{Binding CanCopyRunId}" Click="OnCopyRunIdClick" ToolTip.Tip="Copy Run ID"/>
            <TextBlock Grid.Row="2" Classes="label" Text="DURATION" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" VerticalAlignment="Center" Margin="16,0"/>
            <TextBlock Grid.Row="3" Classes="label" Text="RUN URL" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RunUrl}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Row="3" Grid.Column="2" Classes="copy" Content="⧉" IsEnabled="{Binding CanCopyRunUrl}" Click="OnCopyRunUrlClick" ToolTip.Tip="Copy Run URL"/>
          </Grid>
        </StackPanel>
      </Border>

      <ItemsControl Grid.Row="2" ItemsSource="{Binding Jobs}" Margin="0,10,0,3">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:CiJob">
            <Border Background="#22000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="0,0,6,5">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Status, Converter={x:Static vm:JobStatusConverter.Instance}}" FontSize="12" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,3,0,11">
        <Button Classes="hud" Content="Open Run" IsEnabled="{Binding CanOpenRun}" Click="OnOpenRunClick"/>
        <Button Classes="hud" Content="Failed Logs" IsEnabled="{Binding CanOpenFailedLogs}" Click="OnFailedLogsClick"/>
        <Button Classes="hud" Content="Copy Evidence" Click="OnCopyEvidenceClick"/>
        <Button Classes="hud" Content="Refresh" Click="OnRefreshClick"/>
      </StackPanel>

      <Border Grid.Row="4" BorderBrush="#38FFFFFF" BorderThickness="0,1,0,0" Padding="0,11,0,0">
        <TextBlock Text="DETAILS" Classes="label"/>
      </Border>

      <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="detailLabel" Text="REPOSITORY"/><TextBlock Grid.Column="1" Text="{Binding RepositoryName}" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Classes="detailLabel" Text="BRANCH"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Branch}" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="2" Classes="detailLabel" Text="SHA"/><TextBlock Grid.Row="2" Grid.Column="1" Classes="id" Text="{Binding FullCiSha}" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="3" Classes="detailLabel" Text="WORKFLOW"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Workflow}" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Classes="detailLabel" Text="RUN #"/><TextBlock Grid.Row="4" Grid.Column="1" Classes="id" Text="{Binding RunNumberText}"/>
          <TextBlock Grid.Row="5" Classes="detailLabel" Text="RUN ID"/><TextBlock Grid.Row="5" Grid.Column="1" Classes="id" Text="{Binding RunIdText}"/>
          <TextBlock Grid.Row="6" Classes="detailLabel" Text="STATUS"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CiStatusText}" Foreground="{Binding StatusBrush}"/>
          <TextBlock Grid.Row="7" Classes="detailLabel" Text="DURATION"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Runtime}"/>
          <TextBlock Grid.Row="8" Classes="detailLabel" Text="STARTED"/><TextBlock Grid.Row="8" Grid.Column="1" Classes="id" Text="{Binding StartedText}"/>
          <TextBlock Grid.Row="9" Classes="detailLabel" Text="COMPLETED"/><TextBlock Grid.Row="9" Grid.Column="1" Classes="id" Text="{Binding CompletedText}"/>
          <TextBlock Grid.Row="10" Classes="detailLabel" Text="RUN URL"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding RunUrl}" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="11" Classes="detailLabel" Text="LOCAL CLONE"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding LocalStatus}" TextWrapping="Wrap"/>
        </Grid>
      </ScrollViewer>

      <Grid Grid.Row="6" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
        <Button Classes="gear" Content="⚙" Click="OnSettingsClick" ToolTip.Tip="Settings"/>
        <TextBlock Grid.Column="1" Text="HeadsUp" Opacity=".5" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
