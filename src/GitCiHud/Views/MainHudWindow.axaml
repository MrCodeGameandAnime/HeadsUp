<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:GitCiHud.Models" xmlns:vm="clr-namespace:GitCiHud.ViewModels" x:Class="GitCiHud.Views.MainHudWindow" x:DataType="vm:MainHudViewModel" Width="505" Height="255" MinWidth="365" MinHeight="190" SystemDecorations="None" TransparencyLevelHint="AcrylicBlur,Transparent" Background="Transparent" ShowInTaskbar="True">
  <Window.Styles>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Opacity" Value=".65"/></Style>
    <Style Selector="TextBlock.sha"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/></Style>
    <Style Selector="Button.hud"><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="9,4"/><Setter Property="Background" Value="#26000000"/><Setter Property="BorderBrush" Value="#38FFFFFF"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button.close"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="5,1"/></Style>
  </Window.Styles>
  <Border Margin="1" Background="{Binding SurfaceBrush}" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="11" Padding="14,10">
    <Grid RowDefinitions="Auto,*,Auto,Auto" PointerPressed="OnHudPointerPressed">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Background="Transparent" Cursor="SizeAll" PointerPressed="OnHeaderPointerPressed"><TextBlock Text="{Binding RepositoryName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Branch}" Opacity=".8" FontSize="12" VerticalAlignment="Center" Margin="8,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Classes="close" Content="×" Click="OnCloseClick"/></Grid>
      <Grid Grid.Row="1" Margin="0,10" ColumnDefinitions="*,*">
        <StackPanel Margin="0,0,10,0"><TextBlock Classes="label" Text="LOCAL"/><TextBlock Classes="sha" Text="{Binding LocalSha}" Margin="0,4"/><TextBlock Text="{Binding LocalStatus}"/><TextBlock Text="{Binding CommitAge}" Opacity=".75" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Classes="label" Text="GITHUB ACTIONS"/><TextBlock Classes="sha" Text="{Binding CiSha}" Margin="0,4"/><TextBlock Text="{Binding CiStatusText}"/><TextBlock Text="{Binding Workflow}" Opacity=".9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Runtime}" Opacity=".75" Margin="0,3,0,0"/></StackPanel>
      </Grid>
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Jobs}" IsVisible="{Binding Expanded}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:CiJob"><TextBlock Margin="0,0,14,4"><Run Text="{Binding Name}"/><Run Text="  "/><Run Text="{Binding Status, Converter={x:Static vm:JobStatusConverter.Instance}}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><Button Classes="hud" Content="Open Run" IsEnabled="{Binding CanOpenRun}" Click="OnOpenRunClick"/><Button Classes="hud" Content="Failed Logs" IsEnabled="{Binding CanOpenFailedLogs}" Click="OnFailedLogsClick" Margin="7,0,0,0"/><Button Classes="hud" Content="Refresh" Click="OnRefreshClick" Margin="7,0,0,0"/></StackPanel><Grid Grid.Row="1" Margin="0,10,0,0" IsVisible="{Binding Expanded}" RowDefinitions="Auto,Auto,Auto,Auto"><TextBlock><Run Text="Repository    "/><Run Text="{Binding RepositoryName}"/></TextBlock><TextBlock Grid.Row="1"><Run Text="Branch          "/><Run Text="{Binding Branch}"/></TextBlock><TextBlock Grid.Row="2" FontFamily="Cascadia Mono,Consolas,monospace"><Run Text="Local           "/><Run Text="{Binding FullLocalSha}"/></TextBlock><TextBlock Grid.Row="3" FontFamily="Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis"><Run Text="Remote        "/><Run Text="{Binding FullRemoteSha}"/><Run Text="    CI  "/><Run Text="{Binding FullCiSha}"/></TextBlock></Grid></Grid>
    </Grid>
  </Border>
</Window>
